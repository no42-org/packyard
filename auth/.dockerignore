# Exclude host-side build outputs and dev artifacts so the Dockerfile's
# `COPY .` lands a clean tree. Without these, a developer's local
# `make admin-ui` output could merge with the multi-stage SPA build, and
# host-platform node_modules (Darwin/glibc) could leak into the Alpine
# image.

# Vite output — regenerated by the spa-builder stage.
internal/admin-ui/dist/

# Node modules — built fresh inside the spa-builder stage via npm ci.
internal/admin-ui/node_modules/

# Vite dev cache.
internal/admin-ui/.vite/

# Embedded dist tree — overwritten by the spa-builder stage's COPY.
# Keep the placeholder so //go:embed all:dist always has a target.
internal/adminui/dist/*
!internal/adminui/dist/.gitkeep

# Go build artefacts (only matters if a host build happened in this tree).
bin/

# Editor / OS noise.
.DS_Store
*.swp
